diff --git a/kernel/sched/ext.c b/kernel/sched/ext.c
new file mode 100644
index 000000000000..368a5f9efb38
--- /dev/null
+++ b/kernel/sched/ext.c
@@ -0,0 +1,1734 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * KMI-clean sched_ext (BPF extensible scheduler) implementation for Linux 6.1 GKI
+ *
+ * Preserves exact sizeof(struct task_struct), sizeof(struct rq), and Module.symvers
+ * KMI ABI hashes by storing per-task state in task_struct::android_oem_data1[0..5]
+ * and per-CPU dispatch queues in per-CPU storage.
+ */
+
+#include <linux/sched/cputime.h>
+#include "sched.h"
+#include <linux/sched/ext.h>
+#include <linux/bpf.h>
+#include <linux/bpf_verifier.h>
+#include <linux/btf.h>
+#include <linux/btf_ids.h>
+#include <linux/filter.h>
+#include <linux/kobject.h>
+#include <linux/sysfs.h>
+#include <linux/cpumask.h>
+#include <linux/cgroup.h>
+#include <linux/percpu.h>
+#include <linux/spinlock.h>
+#include <linux/rcupdate.h>
+
+#define SCX_OEM_MAGIC		0x5c70U
+#define SCX_MAX_USER_DSQS	64
+
+#define SCX_TF_QUEUED		(1U << 0)
+#define SCX_TF_DIRECT_LOCAL	(1U << 1)
+#define SCX_TF_INITED		(1U << 2)
+
+/*
+ * Mapped onto task_struct::android_oem_data1[0..5] (48 bytes).
+ * Notice android_oem_data1[0] is dsq_vtime and android_oem_data1[1] is slice.
+ */
+struct scx_task_oem {
+	u64			dsq_vtime;	/* [0] */
+	u64			slice;		/* [1] */
+	u16			dsq_slot;	/* [2] 0=none, 1=local, 2..65=user_dsqs[0..63] */
+	s16			selected_cpu;	/* [2] target cpu from select_cpu */
+	s16			queued_cpu;	/* [2] cpu whose scx_cpu_rq holds @node */
+	u16			magic;		/* [2] SCX_OEM_MAGIC */
+	u32			weight;		/* [3] */
+	u32			flags;		/* [3] SCX_TF_* */
+	struct list_head	node;		/* [4..5] */
+};
+
+struct scx_cpu_rq {
+	raw_spinlock_t		lock;
+	struct list_head	local_dsq;
+	struct list_head	user_dsqs[SCX_MAX_USER_DSQS];
+	u32			nr_queued;
+	u32			local_nr_queued;
+	u32			user_nr_queued[SCX_MAX_USER_DSQS];
+	u32			cpuperf_target;
+};
+
+static DEFINE_PER_CPU(struct scx_cpu_rq, scx_cpu_rqs);
+static DEFINE_PER_CPU(int, scx_in_select_cpu);
+static DEFINE_PER_CPU(int, scx_dispatch_cpu);
+
+static cpumask_t scx_idle_cpumask_storage;
+static DEFINE_MUTEX(scx_ops_mutex);
+static DEFINE_RAW_SPINLOCK(scx_dsq_id_lock);
+static u64 scx_user_dsq_ids[SCX_MAX_USER_DSQS];
+static bool scx_user_dsq_used[SCX_MAX_USER_DSQS];
+
+static DEFINE_STATIC_KEY_FALSE(scx_ops_enabled_key);
+static struct sched_ext_ops scx_active_ops;
+static struct scx_exit_info scx_active_exit_info;
+static char scx_exit_reason_buf[64] = "unregistered";
+static char scx_exit_msg_buf[256];
+static char scx_exit_dump_buf[256];
+static atomic64_t scx_enable_seq = ATOMIC64_INIT(0);
+static atomic64_t scx_hotplug_seq_cnt = ATOMIC64_INIT(0);
+
+/* Ensure BTF types for all scx enums and structs are emitted into vmlinux BTF */
+struct __scx_btf_type_holder {
+	enum scx_public_consts			e1;
+	enum scx_consts				e2;
+	enum scx_dsq_id_flags			e3;
+	enum scx_ent_flags			e4;
+	enum scx_ent_dsq_flags			e5;
+	enum scx_rq_flags			e6;
+	enum scx_kick_flags			e7;
+	enum scx_enq_flags			e8;
+	enum scx_deq_flags			e9;
+	enum scx_exit_kind			e10;
+	enum scx_cpu_preempt_reason		e11;
+	struct scx_exit_info			s1;
+	struct scx_init_task_args		s2;
+	struct scx_exit_task_args		s3;
+	struct scx_dump_ctx			s4;
+	struct scx_bpf_dsq_insert_vtime_args	s5;
+};
+
+static __always_inline u16 scx_task_magic(const struct task_struct *p)
+{
+	unsigned long v = (unsigned long)p;
+	u16 h = (u16)((v >> 6) ^ (v >> 22) ^ (v >> 38) ^ SCX_OEM_MAGIC);
+
+	return h ? h : 1;
+}
+
+static __always_inline struct scx_task_oem *scx_task_data(struct task_struct *p)
+{
+	struct scx_task_oem *oem;
+	u16 magic = scx_task_magic(p);
+
+	BUILD_BUG_ON(sizeof(struct scx_task_oem) > sizeof(p->android_oem_data1));
+	oem = (struct scx_task_oem *)&p->android_oem_data1[0];
+	if (unlikely(oem->magic != magic)) {
+		oem->dsq_vtime = 0;
+		oem->slice = SCX_SLICE_DFL;
+		oem->dsq_slot = 0;
+		oem->selected_cpu = -1;
+		oem->queued_cpu = -1;
+		oem->weight = p->prio < 120 ? 200 : 100;
+		oem->flags = 0;
+		INIT_LIST_HEAD(&oem->node);
+		smp_wmb();
+		oem->magic = magic;
+	}
+	return oem;
+}
+
+void scx_task_fork(struct task_struct *p)
+{
+	struct scx_task_oem *oem = (struct scx_task_oem *)&p->android_oem_data1[0];
+
+	oem->dsq_vtime = 0;
+	oem->slice = SCX_SLICE_DFL;
+	oem->dsq_slot = 0;
+	oem->selected_cpu = -1;
+	oem->queued_cpu = -1;
+	oem->weight = p->prio < 120 ? 200 : 100;
+	oem->flags = 0;
+	INIT_LIST_HEAD(&oem->node);
+	smp_wmb();
+	oem->magic = scx_task_magic(p);
+}
+
+bool scx_enabled(void)
+{
+	return static_branch_unlikely(&scx_ops_enabled_key);
+}
+
+static int scx_find_user_dsq_slot(u64 dsq_id)
+{
+	int i;
+
+	for (i = 0; i < SCX_MAX_USER_DSQS; i++) {
+		if (READ_ONCE(scx_user_dsq_used[i]) &&
+		    READ_ONCE(scx_user_dsq_ids[i]) == dsq_id)
+			return i;
+	}
+	return -ENOENT;
+}
+
+static void scx_task_unlink(struct task_struct *p)
+{
+	struct scx_task_oem *oem = scx_task_data(p);
+	int qcpu = READ_ONCE(oem->queued_cpu);
+	struct scx_cpu_rq *crq;
+	unsigned long flags;
+
+	if (!(READ_ONCE(oem->flags) & SCX_TF_QUEUED) ||
+	    qcpu < 0 || qcpu >= nr_cpu_ids) {
+		oem->dsq_slot = 0;
+		oem->queued_cpu = -1;
+		oem->flags &= ~SCX_TF_QUEUED;
+		INIT_LIST_HEAD(&oem->node);
+		return;
+	}
+
+	crq = &per_cpu(scx_cpu_rqs, qcpu);
+	raw_spin_lock_irqsave(&crq->lock, flags);
+	if ((oem->flags & SCX_TF_QUEUED) && oem->queued_cpu == qcpu &&
+	    oem->node.next && oem->node.prev && !list_empty(&oem->node)) {
+		list_del_init(&oem->node);
+		if (crq->nr_queued > 0)
+			crq->nr_queued--;
+		if (oem->dsq_slot == 1) {
+			if (crq->local_nr_queued > 0)
+				crq->local_nr_queued--;
+		} else if (oem->dsq_slot >= 2 &&
+			   oem->dsq_slot < SCX_MAX_USER_DSQS + 2) {
+			u16 idx = oem->dsq_slot - 2;
+			if (crq->user_nr_queued[idx] > 0)
+				crq->user_nr_queued[idx]--;
+		}
+	} else {
+		INIT_LIST_HEAD(&oem->node);
+	}
+	oem->dsq_slot = 0;
+	oem->queued_cpu = -1;
+	oem->flags &= ~SCX_TF_QUEUED;
+	raw_spin_unlock_irqrestore(&crq->lock, flags);
+}
+
+void scx_task_picked_fallback(struct task_struct *p)
+{
+	if (p && scx_enabled())
+		scx_task_unlink(p);
+}
+
+static void scx_task_insert_on_cpu(struct task_struct *p, int cpu, u16 slot,
+				   u64 slice, u64 vtime, bool use_vtime,
+				   u64 enq_flags)
+{
+	struct scx_task_oem *oem = scx_task_data(p);
+	struct scx_cpu_rq *crq;
+	struct list_head *head;
+	unsigned long flags;
+
+	if (cpu < 0 || cpu >= nr_cpu_ids)
+		cpu = task_cpu(p);
+
+	scx_task_unlink(p);
+
+	if (slice > 0)
+		oem->slice = slice;
+	else if (oem->slice == 0)
+		oem->slice = SCX_SLICE_DFL;
+
+	if (use_vtime)
+		oem->dsq_vtime = vtime;
+
+	crq = &per_cpu(scx_cpu_rqs, cpu);
+	raw_spin_lock_irqsave(&crq->lock, flags);
+	INIT_LIST_HEAD(&oem->node);
+
+	if (slot <= 1 || slot > SCX_MAX_USER_DSQS + 1) {
+		head = &crq->local_dsq;
+		slot = 1;
+		if (enq_flags & (SCX_ENQ_HEAD | SCX_ENQ_PREEMPT))
+			list_add(&oem->node, head);
+		else
+			list_add_tail(&oem->node, head);
+		crq->local_nr_queued++;
+	} else {
+		struct scx_task_oem *pos;
+		bool inserted = false;
+
+		head = &crq->user_dsqs[slot - 2];
+		if (use_vtime) {
+			list_for_each_entry(pos, head, node) {
+				if ((s64)(vtime - pos->dsq_vtime) < 0) {
+					list_add_tail(&oem->node, &pos->node);
+					inserted = true;
+					break;
+				}
+			}
+		}
+		if (!inserted) {
+			if (enq_flags & SCX_ENQ_HEAD)
+				list_add(&oem->node, head);
+			else
+				list_add_tail(&oem->node, head);
+		}
+		crq->user_nr_queued[slot - 2]++;
+	}
+
+	oem->dsq_slot = slot;
+	oem->queued_cpu = cpu;
+	oem->flags |= SCX_TF_QUEUED;
+	crq->nr_queued++;
+	raw_spin_unlock_irqrestore(&crq->lock, flags);
+}
+
+/* ==========================================================================
+ * BPF Verifier & kfuncs for sched_ext
+ * ========================================================================== */
+
+__diag_push();
+__diag_ignore_all("-Wmissing-prototypes",
+		  "Global kfuncs whose prototypes are emitted into vmlinux BTF");
+
+__used noinline s32 scx_bpf_create_dsq(u64 dsq_id, s32 node)
+{
+	unsigned long flags;
+	int i, free_slot = -1;
+
+	if (dsq_id & SCX_DSQ_FLAG_BUILTIN)
+		return -EINVAL;
+
+	raw_spin_lock_irqsave(&scx_dsq_id_lock, flags);
+	for (i = 0; i < SCX_MAX_USER_DSQS; i++) {
+		if (scx_user_dsq_used[i] && scx_user_dsq_ids[i] == dsq_id) {
+			raw_spin_unlock_irqrestore(&scx_dsq_id_lock, flags);
+			return 0;
+		}
+		if (!scx_user_dsq_used[i] && free_slot < 0)
+			free_slot = i;
+	}
+	if (free_slot >= 0) {
+		scx_user_dsq_ids[free_slot] = dsq_id;
+		scx_user_dsq_used[free_slot] = true;
+	}
+	raw_spin_unlock_irqrestore(&scx_dsq_id_lock, flags);
+
+	return free_slot >= 0 ? 0 : -ENOSPC;
+}
+
+__used noinline void scx_bpf_destroy_dsq(u64 dsq_id)
+{
+	unsigned long flags;
+	int i;
+
+	raw_spin_lock_irqsave(&scx_dsq_id_lock, flags);
+	for (i = 0; i < SCX_MAX_USER_DSQS; i++) {
+		if (scx_user_dsq_used[i] && scx_user_dsq_ids[i] == dsq_id) {
+			scx_user_dsq_used[i] = false;
+			scx_user_dsq_ids[i] = 0;
+		}
+	}
+	raw_spin_unlock_irqrestore(&scx_dsq_id_lock, flags);
+}
+
+static bool __scx_do_insert(struct task_struct *p, u64 dsq_id, u64 slice,
+			    u64 vtime, bool use_vtime, u64 enq_flags)
+{
+	struct scx_task_oem *oem;
+	int cpu, slot = 1;
+
+	if (!p)
+		return false;
+
+	oem = scx_task_data(p);
+	if (this_cpu_read(scx_in_select_cpu)) {
+		if ((dsq_id & SCX_DSQ_FLAG_BUILTIN) == 0) {
+			int idx = scx_find_user_dsq_slot(dsq_id);
+			if (idx >= 0) {
+				oem->slice = slice ? slice : SCX_SLICE_DFL;
+				if (use_vtime)
+					oem->dsq_vtime = vtime;
+				oem->dsq_slot = idx + 2;
+				oem->flags |= SCX_TF_DIRECT_LOCAL;
+				return true;
+			}
+		}
+		oem->slice = slice ? slice : SCX_SLICE_DFL;
+		if (use_vtime)
+			oem->dsq_vtime = vtime;
+		oem->dsq_slot = 1;
+		oem->flags |= SCX_TF_DIRECT_LOCAL;
+		if ((dsq_id & SCX_DSQ_LOCAL_ON) == SCX_DSQ_LOCAL_ON) {
+			s32 tcpu = (s32)(dsq_id & SCX_DSQ_LOCAL_CPU_MASK);
+			if (tcpu >= 0 && tcpu < nr_cpu_ids)
+				oem->selected_cpu = tcpu;
+		}
+		return true;
+	}
+
+	cpu = task_cpu(p);
+	if ((dsq_id & SCX_DSQ_FLAG_BUILTIN) == 0) {
+		int idx = scx_find_user_dsq_slot(dsq_id);
+		if (idx >= 0)
+			slot = idx + 2;
+	} else if ((dsq_id & SCX_DSQ_LOCAL_ON) == SCX_DSQ_LOCAL_ON) {
+		s32 tcpu = (s32)(dsq_id & SCX_DSQ_LOCAL_CPU_MASK);
+		if (tcpu >= 0 && tcpu < nr_cpu_ids &&
+		    cpumask_test_cpu(tcpu, p->cpus_ptr))
+			oem->selected_cpu = tcpu;
+		slot = 1;
