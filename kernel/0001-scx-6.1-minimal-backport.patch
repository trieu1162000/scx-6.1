+static void scx_reset_all_queues(void)
+{
+	int cpu, i;
+
+	for_each_possible_cpu(cpu) {
+		struct scx_cpu_rq *crq = &per_cpu(scx_cpu_rqs, cpu);
+		struct scx_task_oem *oem, *tmp;
+		unsigned long flags;
+
+		raw_spin_lock_irqsave(&crq->lock, flags);
+		list_for_each_entry_safe(oem, tmp, &crq->local_dsq, node) {
+			list_del_init(&oem->node);
+			oem->dsq_slot = 0;
+			oem->queued_cpu = -1;
+			oem->flags &= ~SCX_TF_QUEUED;
+		}
+		for (i = 0; i < SCX_MAX_USER_DSQS; i++) {
+			list_for_each_entry_safe(oem, tmp, &crq->user_dsqs[i], node) {
+				list_del_init(&oem->node);
+				oem->dsq_slot = 0;
+				oem->queued_cpu = -1;
+				oem->flags &= ~SCX_TF_QUEUED;
+			}
+			crq->user_nr_queued[i] = 0;
+		}
+		crq->nr_queued = 0;
+		crq->local_nr_queued = 0;
+		raw_spin_unlock_irqrestore(&crq->lock, flags);
+	}
+}
+
+static __nocfi int bpf_scx_reg(void *kdata)
+{
+	struct sched_ext_ops *ops = kdata;
+	struct task_struct *g, *p;
+	int ret = 0;
+
+	mutex_lock(&scx_ops_mutex);
+	if (scx_enabled()) {
+		mutex_unlock(&scx_ops_mutex);
+		return -EBUSY;
+	}
+
+	scx_reset_all_queues();
+	memset(&scx_active_exit_info, 0, sizeof(scx_active_exit_info));
+	scx_active_exit_info.kind = SCX_EXIT_NONE;
+	scx_active_exit_info.exit_cpu = -1;
+	scx_active_exit_info.reason = scx_exit_reason_buf;
+	scx_active_exit_info.msg = scx_exit_msg_buf;
+	scx_active_exit_info.dump = scx_exit_dump_buf;
+
+	memcpy(&scx_active_ops, ops, sizeof(scx_active_ops));
+
+	if (scx_active_ops.init) {
+		ret = scx_active_ops.init();
+		if (ret) {
+			memset(&scx_active_ops, 0, sizeof(scx_active_ops));
+			mutex_unlock(&scx_ops_mutex);
+			return ret;
+		}
+	}
+
+	rcu_read_lock();
+	for_each_process_thread(g, p) {
+		struct scx_task_oem *oem = scx_task_data(p);
+		if (scx_active_ops.init_task && !(oem->flags & SCX_TF_INITED)) {
+			struct scx_init_task_args args = {
+				.fork = false,
+				.cgroup = task_dfl_cgroup(p),
+			};
+			scx_active_ops.init_task(p, &args);
+			oem->flags |= SCX_TF_INITED;
+		}
+		if (scx_active_ops.enable && p->sched_class == &fair_sched_class)
+			scx_active_ops.enable(p);
+	}
+	rcu_read_unlock();
+
+	atomic64_inc(&scx_enable_seq);
+	static_branch_enable(&scx_ops_enabled_key);
+	pr_info("sched_ext: BPF scheduler \"%s\" enabled\n", scx_active_ops.name);
+	mutex_unlock(&scx_ops_mutex);
+	return 0;
+}
+
+static __nocfi void bpf_sched_ext_unreg(void *kdata)
+{
+	mutex_lock(&scx_ops_mutex);
+	if (!scx_enabled()) {
+		mutex_unlock(&scx_ops_mutex);
+		return;
+	}
+
+	static_branch_disable(&scx_ops_enabled_key);
+	synchronize_rcu();
+
+	if (scx_active_exit_info.kind == SCX_EXIT_NONE)
+		scx_active_exit_info.kind = SCX_EXIT_UNREG;
+
+	if (scx_active_ops.exit)
+		scx_active_ops.exit(&scx_active_exit_info);
+
+	scx_reset_all_queues();
+	pr_info("sched_ext: BPF scheduler \"%s\" disabled\n", scx_active_ops.name);
+	memset(&scx_active_ops, 0, sizeof(scx_active_ops));
+	mutex_unlock(&scx_ops_mutex);
+}
+
+struct bpf_struct_ops bpf_sched_ext_ops = {
+	.verifier_ops	= &bpf_sched_ext_verifier_ops,
+	.reg		= bpf_scx_reg,
+	.unreg		= bpf_sched_ext_unreg,
+	.check_member	= bpf_sched_ext_check_member,
+	.init_member	= bpf_sched_ext_init_member,
+	.init		= bpf_sched_ext_init,
+	.name		= "sched_ext_ops",
+};
