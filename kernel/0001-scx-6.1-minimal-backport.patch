diff --git a/include/linux/sched/ext.h b/include/linux/sched/ext.h
new file mode 100644
index 000000000000..edc3be5dafe9
--- /dev/null
+++ b/include/linux/sched/ext.h
@@ -0,0 +1,217 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_SCHED_EXT_H
+#define _LINUX_SCHED_EXT_H
+
+#include <linux/types.h>
+#include <linux/cpumask.h>
+#include <linux/sched.h>
+
+enum scx_public_consts {
+	SCX_OPS_NAME_LEN	= 128,
+	SCX_SLICE_DFL		= 20 * 1000000ULL,
+	SCX_SLICE_BYPASS	= 5 * 1000000ULL,
+	SCX_SLICE_INF		= ~0ULL,
+};
+
+enum scx_consts {
+	SCX_DSP_DFL_MAX_BATCH	= 32,
+	SCX_DSP_MAX_LOOPS	= 32,
+	SCX_WATCHDOG_MAX_TIMEOUT = 30 * HZ,
+	SCX_RESCUE_DISABLE	= ~0U,
+	SCX_EXIT_BT_LEN		= 64,
+	SCX_EXIT_MSG_LEN	= 1024,
+	SCX_EXIT_DUMP_DFL_LEN	= 32768,
+	SCX_CPUPERF_ONE		= 1024,
+};
+
+enum scx_dsq_id_flags {
+	SCX_DSQ_FLAG_BUILTIN	= (1ULL << 63),
+	SCX_DSQ_FLAG_LOCAL_ON	= (1ULL << 62),
+	SCX_DSQ_INVALID		= SCX_DSQ_FLAG_BUILTIN | 0,
+	SCX_DSQ_GLOBAL		= SCX_DSQ_FLAG_BUILTIN | 1,
+	SCX_DSQ_LOCAL		= SCX_DSQ_FLAG_BUILTIN | 2,
+	SCX_DSQ_BYPASS		= SCX_DSQ_FLAG_BUILTIN | 3,
+	SCX_DSQ_REJECT		= SCX_DSQ_FLAG_BUILTIN | 4,
+	SCX_DSQ_RESCUE		= SCX_DSQ_FLAG_BUILTIN | 5,
+	SCX_DSQ_LOCAL_ON	= SCX_DSQ_FLAG_BUILTIN | SCX_DSQ_FLAG_LOCAL_ON,
+	SCX_DSQ_LOCAL_CPU_MASK	= 0xffffffffULL,
+};
+
+enum scx_ent_flags {
+	SCX_TASK_QUEUED		= 1 << 0,
+	SCX_TASK_IN_CUSTODY	= 1 << 1,
+	SCX_TASK_RESET_RUNNABLE_AT = 1 << 2,
+	SCX_TASK_DEQD_FOR_SLEEP	= 1 << 3,
+	SCX_TASK_SUB_INIT	= 1 << 4,
+	SCX_TASK_IMMED		= 1 << 5,
+	SCX_TASK_PROTECTED	= 1 << 6,
+	SCX_TASK_STATE_SHIFT	= 8,
+	SCX_TASK_STATE_BITS	= 3,
+	SCX_TASK_STATE_MASK	= ((1 << SCX_TASK_STATE_BITS) - 1) << SCX_TASK_STATE_SHIFT,
+	SCX_TASK_NONE		= 0 << SCX_TASK_STATE_SHIFT,
+	SCX_TASK_INIT_BEGIN	= 1 << SCX_TASK_STATE_SHIFT,
+	SCX_TASK_INIT		= 2 << SCX_TASK_STATE_SHIFT,
+	SCX_TASK_READY		= 3 << SCX_TASK_STATE_SHIFT,
+	SCX_TASK_ENABLED	= 4 << SCX_TASK_STATE_SHIFT,
+	SCX_TASK_DEAD		= 5 << SCX_TASK_STATE_SHIFT,
+	SCX_TASK_CURSOR		= 1U << 31,
+};
+
+enum scx_ent_dsq_flags {
+	SCX_TASK_DSQ_ON_PRIQ	= 1 << 0,
+};
+
+enum scx_rq_flags {
+	SCX_RQ_ONLINE		= 1 << 0,
+	SCX_RQ_CAN_STOP_TICK	= 1 << 1,
+	SCX_RQ_CLK_VALID	= 1 << 2,
+	SCX_RQ_IN_WAKEUP	= 1 << 3,
+	SCX_RQ_IN_DISPATCH	= 1 << 4,
+};
+
+enum scx_kick_flags {
+	SCX_KICK_IDLE		= 1ULL << 0,
+	SCX_KICK_PREEMPT	= 1ULL << 1,
+	SCX_KICK_WAIT		= 1ULL << 2,
+	SCX_KICK_PREEMPT_LAZY	= 1ULL << 3,
+	SCX_KICK_ALL_FLAGS	= SCX_KICK_IDLE | SCX_KICK_PREEMPT | SCX_KICK_WAIT | SCX_KICK_PREEMPT_LAZY,
+};
+
+enum scx_enq_flags {
+	SCX_ENQ_WAKEUP		= 1ULL,
+	SCX_ENQ_HEAD		= 16ULL,
+	SCX_ENQ_CPU_SELECTED	= 1024ULL,
+	SCX_ENQ_PREEMPT		= 1ULL << 32,
+	SCX_ENQ_IMMED		= 1ULL << 33,
+	SCX_ENQ_RESCUE		= 1ULL << 34,
+	SCX_ENQ_PREEMPT_LAZY	= 1ULL << 35,
+	SCX_ENQ_BLOCKED		= 1ULL << 36,
+	SCX_ENQ_REENQ		= 1ULL << 40,
+	SCX_ENQ_LAST		= 1ULL << 41,
+	SCX_ENQ_CLEAR_OPSS	= 1ULL << 56,
+	SCX_ENQ_DSQ_PRIQ	= 1ULL << 57,
+};
+
+enum scx_deq_flags {
+	SCX_DEQ_SLEEP		= 1ULL,
+	SCX_DEQ_CORE_SCHED_EXEC	= 1ULL << 32,
+	SCX_DEQ_SCHED_CHANGE	= 1ULL << 33,
+};
+
+enum scx_exit_kind {
+	SCX_EXIT_NONE		= 0,
+	SCX_EXIT_DONE		= 1,
+	SCX_EXIT_UNREG		= 64,
+	SCX_EXIT_UNREG_BPF	= 65,
+	SCX_EXIT_UNREG_KERN	= 66,
+	SCX_EXIT_SYSRQ		= 67,
+	SCX_EXIT_ERROR		= 1024,
+	SCX_EXIT_ERROR_BPF	= 1025,
+	SCX_EXIT_ERROR_STALL	= 1026,
+};
+
+struct scx_exit_info {
+	enum scx_exit_kind	kind;
+	s32			exit_cpu;
+	s64			exit_code;
+	u64			flags;
+	const char		*reason;
+	unsigned long		*bt;
+	u32			bt_len;
+	char			*msg;
+	char			*dump;
+};
+
+struct scx_init_task_args {
+	bool			fork;
+	struct cgroup		*cgroup;
+};
+
+struct scx_exit_task_args {
+	bool			cancelled;
+};
+
+enum scx_cpu_preempt_reason {
+	SCX_CPU_PREEMPT_RT,
+	SCX_CPU_PREEMPT_DL,
+	SCX_CPU_PREEMPT_STOP,
+	SCX_CPU_PREEMPT_UNKNOWN,
+};
+
+struct scx_cpu_acquire_args {};
+
+struct scx_cpu_release_args {
+	enum scx_cpu_preempt_reason reason;
+	struct task_struct	*task;
+};
+
+struct scx_dump_ctx {
+	enum scx_exit_kind	kind;
+	s64			exit_code;
+	const char		*reason;
+	u64			at_ns;
+	u64			at_jiffies;
+};
+
+struct scx_bpf_dsq_insert_vtime_args {
+	u64			dsq_id;
+	u64			slice;
+	u64			vtime;
+	u64			enq_flags;
+};
+
+struct sched_ext_ops {
+	s32 (*select_cpu)(struct task_struct *p, s32 prev_cpu, u64 wake_flags);
+	void (*enqueue)(struct task_struct *p, u64 enq_flags);
+	void (*dequeue)(struct task_struct *p, u64 deq_flags);
+	void (*dispatch)(s32 cpu, struct task_struct *prev);
+	void (*tick)(struct task_struct *p);
+	void (*runnable)(struct task_struct *p, u64 enq_flags);
+	void (*running)(struct task_struct *p);
+	void (*stopping)(struct task_struct *p, bool runnable);
+	void (*quiescent)(struct task_struct *p, u64 deq_flags);
+	bool (*yield)(struct task_struct *from, struct task_struct *to);
+	bool (*core_sched_before)(struct task_struct *a, struct task_struct *b);
+	void (*set_weight)(struct task_struct *p, u32 weight);
+	void (*set_cpumask)(struct task_struct *p, const struct cpumask *cpumask);
+	void (*update_idle)(s32 cpu, bool idle);
+	s32 (*init_task)(struct task_struct *p, struct scx_init_task_args *args);
+	void (*exit_task)(struct task_struct *p, struct scx_exit_task_args *args);
+	void (*enable)(struct task_struct *p);
+	void (*disable)(struct task_struct *p);
+	void (*dump)(struct scx_dump_ctx *ctx);
+	void (*dump_cpu)(struct scx_dump_ctx *ctx, s32 cpu, bool idle);
+	void (*dump_task)(struct scx_dump_ctx *ctx, struct task_struct *p);
+	void (*cpu_online)(s32 cpu);
+	void (*cpu_offline)(s32 cpu);
+	s32 (*init)(void);
+	void (*exit)(struct scx_exit_info *info);
+
+	u32 dispatch_max_batch;
+	u64 flags;
+	u32 timeout_ms;
+	u32 exit_dump_len;
+	u64 hotplug_seq;
+	char name[SCX_OPS_NAME_LEN];
+	void *priv;
+	void (*cpu_acquire)(s32 cpu, struct scx_cpu_acquire_args *args);
+	void (*cpu_release)(s32 cpu, struct scx_cpu_release_args *args);
+};
+
+struct rq;
+struct sched_entity;
+
+bool scx_enabled(void);
+void scx_task_fork(struct task_struct *p);
+void scx_task_picked_fallback(struct task_struct *p);
+int scx_select_task_rq_fair(struct task_struct *p, int prev_cpu, int wake_flags);
+void scx_enqueue_task_fair(struct rq *rq, struct task_struct *p, int flags);
+void scx_dequeue_task_fair(struct rq *rq, struct task_struct *p, int flags);
+void scx_put_prev_task_fair(struct rq *rq, struct task_struct *prev);
+void scx_replace_next_task_fair(struct rq *rq, struct task_struct **p_out,
+				struct sched_entity **se_out, bool *repick_out,
+				struct task_struct *prev);
+void scx_task_tick_fair(struct rq *rq, struct task_struct *curr, int queued);
+void scx_notify_pick_idle(int cpu);
+
+#endif /* _LINUX_SCHED_EXT_H */
