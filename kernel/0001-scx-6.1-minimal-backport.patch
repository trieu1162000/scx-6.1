diff --git a/kernel/bpf/bpf_struct_ops.c b/kernel/bpf/bpf_struct_ops.c
index 84b2d9dba79a..59a25498cfc9 100644
--- a/kernel/bpf/bpf_struct_ops.c
+++ b/kernel/bpf/bpf_struct_ops.c
@@ -575,6 +575,10 @@ static void bpf_struct_ops_map_free(struct bpf_map *map)
 {
 	struct bpf_struct_ops_map *st_map = (struct bpf_struct_ops_map *)map;
 
+	if (cmpxchg(&st_map->kvalue.state, BPF_STRUCT_OPS_STATE_INUSE,
+		    BPF_STRUCT_OPS_STATE_TOBEFREE) == BPF_STRUCT_OPS_STATE_INUSE)
+		st_map->st_ops->unreg(&st_map->kvalue.data);
+
 	if (st_map->links)
 		bpf_struct_ops_map_put_progs(st_map);
 	bpf_map_area_free(st_map->links);
@@ -586,7 +590,7 @@ static void bpf_struct_ops_map_free(struct bpf_map *map)
 static int bpf_struct_ops_map_alloc_check(union bpf_attr *attr)
 {
 	if (attr->key_size != sizeof(unsigned int) || attr->max_entries != 1 ||
-	    attr->map_flags || !attr->btf_vmlinux_value_type_id)
+	    (attr->map_flags & ~(1U << 13)) || !attr->btf_vmlinux_value_type_id)
 		return -EINVAL;
 	return 0;
 }
@@ -699,3 +703,70 @@ void bpf_struct_ops_put(const void *kdata)
 		call_rcu(&st_map->rcu, bpf_struct_ops_put_rcu);
 	}
 }
+
+struct bpf_struct_ops_map_link {
+	struct bpf_link link;
+	struct bpf_map *map;
+};
+
+static void bpf_struct_ops_map_link_release(struct bpf_link *link)
+{
+	struct bpf_struct_ops_map_link *st_link =
+		container_of(link, struct bpf_struct_ops_map_link, link);
+	u32 zero = 0;
+
+	bpf_struct_ops_map_delete_elem(st_link->map, &zero);
+}
+
+static void bpf_struct_ops_map_link_dealloc(struct bpf_link *link)
+{
+	struct bpf_struct_ops_map_link *st_link =
+		container_of(link, struct bpf_struct_ops_map_link, link);
+
+	bpf_map_put(st_link->map);
+	kfree(st_link);
+}
+
+static const struct bpf_link_ops bpf_struct_ops_map_link_lops = {
+	.release = bpf_struct_ops_map_link_release,
+	.dealloc = bpf_struct_ops_map_link_dealloc,
+};
+
+int bpf_struct_ops_link_create(const union bpf_attr *attr)
+{
+	struct bpf_struct_ops_map_link *st_link;
+	struct bpf_link_primer link_primer;
+	struct bpf_map *map;
+	int err;
+
+	map = bpf_map_get(attr->link_create.prog_fd);
+	if (IS_ERR(map))
+		return PTR_ERR(map);
+
+	if (map->map_type != BPF_MAP_TYPE_STRUCT_OPS) {
+		err = -EINVAL;
+		goto err_put;
+	}
+
+	st_link = kzalloc(sizeof(*st_link), GFP_USER);
+	if (!st_link) {
+		err = -ENOMEM;
+		goto err_put;
+	}
+
+	bpf_link_init(&st_link->link, BPF_LINK_TYPE_STRUCT_OPS,
+		      &bpf_struct_ops_map_link_lops, NULL);
+	st_link->map = map;
+
+	err = bpf_link_prime(&st_link->link, &link_primer);
+	if (err) {
+		kfree(st_link);
+		goto err_put;
+	}
+
+	return bpf_link_settle(&link_primer);
+
+err_put:
+	bpf_map_put(map);
+	return err;
+}
