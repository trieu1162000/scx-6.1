+/* ==========================================================================
+ * Scheduler Hooks Called from fair.c
+ * ========================================================================== */
+
+__nocfi int scx_select_task_rq_fair(struct task_struct *p, int prev_cpu, int wake_flags)
+{
+	struct scx_task_oem *oem;
+	s32 target_cpu = -1;
+
+	if (!scx_enabled() || !scx_active_ops.select_cpu)
+		return -1;
+
+	if (p->nr_cpus_allowed <= 1 || is_migration_disabled(p))
+		return -1;
+
+	oem = scx_task_data(p);
+	oem->selected_cpu = -1;
+
+	this_cpu_write(scx_in_select_cpu, 1);
+	rcu_read_lock();
+	target_cpu = scx_active_ops.select_cpu(p, prev_cpu, (u64)wake_flags);
+	rcu_read_unlock();
+	this_cpu_write(scx_in_select_cpu, 0);
+
+	if (oem->selected_cpu >= 0 && oem->selected_cpu < nr_cpu_ids &&
+	    cpumask_test_cpu(oem->selected_cpu, p->cpus_ptr) &&
+	    cpu_online(oem->selected_cpu)) {
+		return oem->selected_cpu;
+	}
+
+	if (target_cpu >= 0 && target_cpu < nr_cpu_ids &&
+	    cpumask_test_cpu(target_cpu, p->cpus_ptr) &&
+	    cpu_online(target_cpu)) {
+		oem->selected_cpu = target_cpu;
+		return target_cpu;
+	}
+
+	return -1;
+}
+
+__nocfi void scx_enqueue_task_fair(struct rq *rq, struct task_struct *p, int flags)
+{
+	struct scx_task_oem *oem;
+	int cpu = cpu_of(rq);
+	u64 enq_flags = 0;
+
+	if (cpumask_test_and_clear_cpu(cpu, &scx_idle_cpumask_storage) &&
+	    scx_enabled() && scx_active_ops.update_idle) {
+		rcu_read_lock();
+		scx_active_ops.update_idle(cpu, false);
+		rcu_read_unlock();
+	}
+
+	if (!scx_enabled())
+		return;
+
+	oem = scx_task_data(p);
+	oem->weight = p->prio < 120 ? 200 : 100;
+
+	if (flags & ENQUEUE_WAKEUP)
+		enq_flags |= SCX_ENQ_WAKEUP;
+	if (flags & ENQUEUE_HEAD)
+		enq_flags |= SCX_ENQ_HEAD;
+
+	rcu_read_lock();
+	if (scx_active_ops.init_task && unlikely(!(oem->flags & SCX_TF_INITED))) {
+		struct scx_init_task_args args = {
+			.fork = false,
+			.cgroup = task_dfl_cgroup(p),
+		};
+		scx_active_ops.init_task(p, &args);
+		oem->flags |= SCX_TF_INITED;
+	}
+
+	if ((flags & ENQUEUE_WAKEUP) && scx_active_ops.runnable)
+		scx_active_ops.runnable(p, enq_flags);
+
+	if (oem->flags & SCX_TF_DIRECT_LOCAL) {
+		u8 direct_slot = oem->dsq_slot >= 1 ? oem->dsq_slot : 1;
+		oem->flags &= ~SCX_TF_DIRECT_LOCAL;
+		scx_task_insert_on_cpu(p, cpu, direct_slot, oem->slice,
+				       oem->dsq_vtime, direct_slot > 1, enq_flags);
+	} else if (scx_active_ops.enqueue) {
+		scx_active_ops.enqueue(p, enq_flags);
+		if (!(oem->flags & SCX_TF_QUEUED))
+			scx_task_insert_on_cpu(p, cpu, 1, SCX_SLICE_DFL, 0, false, enq_flags);
+	} else {
+		scx_task_insert_on_cpu(p, cpu, 1, SCX_SLICE_DFL, 0, false, enq_flags);
+	}
+	rcu_read_unlock();
+}
+
+__nocfi void scx_dequeue_task_fair(struct rq *rq, struct task_struct *p, int flags)
+{
+	scx_task_unlink(p);
+
+	if (!scx_enabled())
+		return;
+
+	rcu_read_lock();
+	if ((flags & DEQUEUE_SLEEP) && scx_active_ops.stopping)
+		scx_active_ops.stopping(p, false);
+	if (scx_active_ops.dequeue)
+		scx_active_ops.dequeue(p, (flags & DEQUEUE_SLEEP) ? SCX_DEQ_SLEEP : 0);
+	if ((flags & DEQUEUE_SLEEP) && scx_active_ops.quiescent)
+		scx_active_ops.quiescent(p, SCX_DEQ_SLEEP);
+	rcu_read_unlock();
+}
+
+__nocfi void scx_put_prev_task_fair(struct rq *rq, struct task_struct *prev)
+{
+	if (!scx_enabled())
+		return;
+
+	rcu_read_lock();
+	if (scx_active_ops.stopping && prev->on_rq)
+		scx_active_ops.stopping(prev, true);
+	rcu_read_unlock();
+
+	if (prev->on_rq == TASK_ON_RQ_QUEUED && task_rq(prev) == rq) {
+		struct scx_task_oem *oem = scx_task_data(prev);
+		if (!(oem->flags & SCX_TF_QUEUED)) {
+			if (scx_active_ops.enqueue) {
+				rcu_read_lock();
+				scx_active_ops.enqueue(prev, 0);
+				rcu_read_unlock();
+			}
+			if (!(oem->flags & SCX_TF_QUEUED))
+				scx_task_insert_on_cpu(prev, cpu_of(rq), 1,
+						       SCX_SLICE_DFL, 0, false, 0);
+		}
+	}
+}
+
+static bool scx_task_can_be_picked(struct rq *rq, struct task_struct *p,
+				   struct task_struct *prev)
+{
+	struct sched_entity *se;
+
+	if (!p || p->sched_class != &fair_sched_class)
+		return false;
+	if ((p != prev && p->on_cpu) || p->on_rq != TASK_ON_RQ_QUEUED)
+		return false;
+	if (task_cpu(p) != cpu_of(rq))
+		return false;
+	if (cfs_rq_of(&p->se)->curr == &p->se)
+		return false;
+
+	for (se = &p->se; se; se = se->parent) {
+		if (!se->on_rq)
+			return false;
+#ifdef CONFIG_CFS_BANDWIDTH
+		if (cfs_rq_of(se)->throttled)
+			return false;
+#endif
+	}
+	return true;
+}
+
+extern void set_next_entity(struct cfs_rq *cfs_rq, struct sched_entity *se);
+
+__nocfi void scx_replace_next_task_fair(struct rq *rq, struct task_struct **p_out,
+				struct sched_entity **se_out, bool *repick_out,
+				struct task_struct *prev)
+{
+	int cpu = cpu_of(rq);
+	struct scx_cpu_rq *crq = &per_cpu(scx_cpu_rqs, cpu);
+	struct task_struct *next = NULL;
+	struct scx_task_oem *oem, *tmp;
+	unsigned long flags;
+
+	if (!scx_enabled())
+		return;
+
+	if ((crq->nr_queued > crq->local_nr_queued ||
+	     list_empty(&crq->local_dsq)) &&
+	    scx_active_ops.dispatch) {
+		this_cpu_write(scx_dispatch_cpu, cpu);
+		rcu_read_lock();
+		scx_active_ops.dispatch(cpu, prev);
+		rcu_read_unlock();
+		this_cpu_write(scx_dispatch_cpu, -1);
+	}
+
+	raw_spin_lock_irqsave(&crq->lock, flags);
+	list_for_each_entry_safe(oem, tmp, &crq->local_dsq, node) {
+		struct task_struct *cand = container_of((u64 *)oem,
+							struct task_struct,
+							android_oem_data1[0]);
+		list_del_init(&oem->node);
+		oem->dsq_slot = 0;
+		oem->queued_cpu = -1;
+		oem->flags &= ~SCX_TF_QUEUED;
+		if (crq->nr_queued > 0)
+			crq->nr_queued--;
+		if (crq->local_nr_queued > 0)
+			crq->local_nr_queued--;
+
+		if (scx_task_can_be_picked(rq, cand, prev)) {
+			next = cand;
+			break;
+		}
+	}
+	raw_spin_unlock_irqrestore(&crq->lock, flags);
+
+	if (!next)
+		return;
+
+	*p_out = next;
+	*se_out = &next->se;
+	*repick_out = true;
+
+	{
+		struct sched_entity *path[8];
+		struct sched_entity *se = &next->se;
+		int depth = 0;
+
+		for (; se && depth < 8; se = se->parent)
+			path[depth++] = se;
+		while (--depth >= 0) {
+			struct cfs_rq *cfs_rq = cfs_rq_of(path[depth]);
+			if (cfs_rq->curr != path[depth])
+				set_next_entity(cfs_rq, path[depth]);
+		}
+	}
+
+	if (scx_active_ops.running) {
+		rcu_read_lock();
+		scx_active_ops.running(next);
+		rcu_read_unlock();
+	}
+}
+
+__nocfi void scx_task_tick_fair(struct rq *rq, struct task_struct *curr, int queued)
+{
+	struct scx_task_oem *oem;
+
+	if (!scx_enabled() || !curr)
+		return;
+
+	oem = scx_task_data(curr);
+	if (scx_active_ops.tick) {
+		rcu_read_lock();
+		scx_active_ops.tick(curr);
+		rcu_read_unlock();
+	}
+
+	if (oem->slice > TICK_NSEC) {
+		oem->slice -= TICK_NSEC;
+	} else {
+		oem->slice = 0;
+		if (queued && rq->cfs.h_nr_running > 1)
+			resched_curr(rq);
+	}
+}
+
+void scx_notify_pick_idle(int cpu)
+{
+	if (cpu >= 0 && cpu < nr_cpu_ids) {
+		if (!cpumask_test_and_set_cpu(cpu, &scx_idle_cpumask_storage) &&
+		    scx_enabled() && scx_active_ops.update_idle) {
+			rcu_read_lock();
+			scx_active_ops.update_idle(cpu, true);
+			rcu_read_unlock();
+		}
+	}
+}
+
+/* ==========================================================================
+ * /sys/kernel/sched_ext/ sysfs hierarchy
+ * ========================================================================== */
+
+static ssize_t state_show(struct kobject *kobj, struct kobj_attribute *attr,
+			  char *buf)
+{
+	return sysfs_emit(buf, "%s\n", scx_enabled() ? "enabled" : "disabled");
+}
+static struct kobj_attribute scx_attr_state = __ATTR_RO(state);
+
+static ssize_t hotplug_seq_show(struct kobject *kobj,
+				struct kobj_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "%lld\n", atomic64_read(&scx_hotplug_seq_cnt));
+}
+static struct kobj_attribute scx_attr_hotplug_seq = __ATTR_RO(hotplug_seq);
+
+static ssize_t enable_seq_show(struct kobject *kobj,
+			       struct kobj_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "%lld\n", atomic64_read(&scx_enable_seq));
+}
+static struct kobj_attribute scx_attr_enable_seq = __ATTR_RO(enable_seq);
+
+static ssize_t ops_show(struct kobject *kobj, struct kobj_attribute *attr,
+			char *buf)
+{
+	return sysfs_emit(buf, "%s\n", scx_enabled() ? scx_active_ops.name : "");
+}
+static struct kobj_attribute scx_root_attr_ops = __ATTR_RO(ops);
+
+static struct attribute *scx_top_attrs[] = {
+	&scx_attr_state.attr,
+	&scx_attr_hotplug_seq.attr,
+	&scx_attr_enable_seq.attr,
+	NULL,
+};
+
+static const struct attribute_group scx_top_attr_group = {
+	.attrs = scx_top_attrs,
+};
+
+static struct attribute *scx_root_attrs[] = {
+	&scx_root_attr_ops.attr,
+	NULL,
+};
+
+static const struct attribute_group scx_root_attr_group = {
+	.attrs = scx_root_attrs,
+};
+
+static struct kobject *scx_kobj;
+static struct kobject *scx_root_kobj;
+
+static int __init scx_ext_init(void)
+{
+	int cpu, i, ret;
+
+	cpumask_clear(&scx_idle_cpumask_storage);
+	for_each_possible_cpu(cpu) {
+		struct scx_cpu_rq *crq = &per_cpu(scx_cpu_rqs, cpu);
+
+		raw_spin_lock_init(&crq->lock);
+		INIT_LIST_HEAD(&crq->local_dsq);
+		for (i = 0; i < SCX_MAX_USER_DSQS; i++) {
+			INIT_LIST_HEAD(&crq->user_dsqs[i]);
+			crq->user_nr_queued[i] = 0;
+		}
+		crq->nr_queued = 0;
+		crq->local_nr_queued = 0;
+		crq->cpuperf_target = 1024;
+		per_cpu(scx_in_select_cpu, cpu) = 0;
+		per_cpu(scx_dispatch_cpu, cpu) = -1;
+	}
+
+	/*
+	 * Register the sched_ext kfunc set for every program type that has a
+	 * kfunc hook. Keep the calls independent so that one unsupported
+	 * program type cannot skip the remaining registrations.
+	 */
+	ret = register_btf_kfunc_id_set(BPF_PROG_TYPE_STRUCT_OPS,
+					&bpf_sched_ext_kfunc_set);
+	if (ret)
+		pr_warn("sched_ext: failed to register struct_ops kfunc set: %d\n", ret);
+	ret = register_btf_kfunc_id_set(BPF_PROG_TYPE_TRACING,
+					&bpf_sched_ext_kfunc_set);
+	if (ret)
+		pr_warn("sched_ext: failed to register tracing kfunc set: %d\n", ret);
+	ret = register_btf_kfunc_id_set(BPF_PROG_TYPE_RAW_TRACEPOINT,
+					&bpf_sched_ext_kfunc_set);
+	if (ret)
+		pr_warn("sched_ext: failed to register raw_tp kfunc set: %d\n", ret);
+	ret = register_btf_kfunc_id_set(BPF_PROG_TYPE_SYSCALL,
+					&bpf_sched_ext_kfunc_set);
+	if (ret)
+		pr_warn("sched_ext: failed to register syscall kfunc set: %d\n", ret);
+
+	scx_kobj = kobject_create_and_add("sched_ext", kernel_kobj);
+	if (scx_kobj) {
+		if (sysfs_create_group(scx_kobj, &scx_top_attr_group) == 0) {
+			scx_root_kobj = kobject_create_and_add("root", scx_kobj);
+			if (scx_root_kobj)
+				(void)sysfs_create_group(scx_root_kobj,
+							 &scx_root_attr_group);
+		}
+	}
+
+	return 0;
+}
+late_initcall(scx_ext_init);
