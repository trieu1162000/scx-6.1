diff --git a/kernel/bpf/btf.c b/kernel/bpf/btf.c
index c67f32f49c92..8b4b55083938 100644
--- a/kernel/bpf/btf.c
+++ b/kernel/bpf/btf.c
@@ -3260,7 +3260,13 @@ static int btf_find_kptr(const struct btf *btf, const struct btf_type *t,
 	else if (!strcmp("kptr_ref", __btf_name_by_offset(btf, t->name_off)))
 		type = BPF_KPTR_REF;
 	else
-		return -EINVAL;
+		/*
+		 * Not a kptr: another type tag (e.g. "arena") on a pointer
+		 * member must not fail the whole map. Returning an error here
+		 * used to make btf_parse_kptrs() fail, which silently
+		 * disabled kptr support for every map holding such a struct.
+		 */
+		return BTF_FIELD_IGNORE;
 
 	/* Get the base type */
 	t = btf_type_skip_modifiers(btf, t->type, &res_id);
@@ -3296,9 +3302,6 @@ static int btf_find_struct_field(const struct btf *btf, const struct btf_type *t
 			/* valid C code cannot generate such BTF */
 			return -EINVAL;
 		off /= 8;
-		if (off % align)
-			return -EINVAL;
-
 		switch (field_type) {
 		case BTF_FIELD_SPIN_LOCK:
 		case BTF_FIELD_TIMER:
@@ -3319,6 +3322,14 @@ static int btf_find_struct_field(const struct btf *btf, const struct btf_type *t
 
 		if (ret == BTF_FIELD_IGNORE)
 			continue;
+		/*
+		 * Only the members that actually matched the field type have
+		 * to satisfy its alignment. Checking every member rejected any
+		 * struct with, say, a u32 at byte offset 4, which silently
+		 * dropped kptr support for the whole map.
+		 */
+		if (off % align)
+			return -EINVAL;
 		if (idx >= info_cnt)
 			return -E2BIG;
 		++idx;
@@ -6255,6 +6266,38 @@ static bool btf_is_kfunc_arg_mem_size(const struct btf *btf,
 	return true;
 }
 
+static bool btf_type_is_cpumask(const struct btf *btf, u32 type_id)
+{
+	const struct btf_type *t;
+	const char *name;
+
+	if (!btf)
+		return false;
+	t = btf_type_skip_modifiers(btf, type_id, NULL);
+	if (!t || !__btf_type_is_struct(t))
+		return false;
+	name = btf_name_by_offset(btf, t->name_off);
+	if (!name || !*name)
+		return false;
+	return !strcmp(name, "cpumask") || !strcmp(name, "bpf_cpumask");
+}
+
+/*
+ * A kfunc argument of type "struct cpumask *" or "struct bpf_cpumask *".
+ * The two are interchangeable at the ABI level: struct bpf_cpumask starts
+ * with a struct cpumask.
+ */
+static bool btf_is_kfunc_cpumask_arg(const struct btf *btf,
+				     const struct btf_param *arg)
+{
+	const struct btf_type *t;
+
+	t = btf_type_skip_modifiers(btf, arg->type, NULL);
+	if (!t || !btf_type_is_ptr(t))
+		return false;
+	return btf_type_is_cpumask(btf, t->type);
+}
+
 static int btf_check_func_arg_match(struct bpf_verifier_env *env,
 				    const struct btf *btf, u32 func_id,
 				    struct bpf_reg_state *regs,
@@ -6451,6 +6494,21 @@ static int btf_check_func_arg_match(struct bpf_verifier_env *env,
 					i, btf_type_str(t));
 				return -EINVAL;
 			}
+		} else if (is_kfunc && base_type(reg->type) == PTR_TO_BTF_ID &&
+			   btf_is_kfunc_cpumask_arg(btf, &args[i]) &&
+			   btf_type_is_cpumask(reg->btf, reg->btf_id)) {
+			/*
+			 * struct bpf_cpumask embeds a struct cpumask as its first
+			 * member, and the sched_ext kfuncs accept either form for
+			 * their cpumask arguments. This also has to work for the
+			 * untrusted pointer a __kptr load produces, which the
+			 * generic PTR_TO_BTF_ID path below does not accept.
+			 */
+			if (reg->off) {
+				bpf_log(log, "R%d has non-zero offset %d for cpumask arg\n",
+					regno, reg->off);
+				return -EINVAL;
+			}
 		} else if (is_kfunc && (reg->type == PTR_TO_BTF_ID ||
 			   (reg2btf_ids[base_type(reg->type)] && !type_flag(reg->type)))) {
 			const struct btf_type *reg_ref_t;
@@ -7353,10 +7411,8 @@ static int btf_populate_kfunc_set(struct btf *btf, enum btf_kfunc_hook hook,
