+static bool __scx_move_to_local(u64 dsq_id)
+{
+	int cpu = this_cpu_read(scx_dispatch_cpu);
+	struct scx_cpu_rq *crq;
+	struct scx_task_oem *oem;
+	unsigned long flags;
+	int idx;
+	bool moved = false;
+
+	if (cpu < 0 || cpu >= nr_cpu_ids)
+		cpu = raw_smp_processor_id();
+
+	if (dsq_id == SCX_DSQ_GLOBAL || dsq_id == SCX_DSQ_LOCAL)
+		return false;
+
+	idx = scx_find_user_dsq_slot(dsq_id);
+	if (idx < 0)
+		return false;
+
+	crq = &per_cpu(scx_cpu_rqs, cpu);
+	raw_spin_lock_irqsave(&crq->lock, flags);
+	if (!list_empty(&crq->user_dsqs[idx])) {
+		oem = list_first_entry(&crq->user_dsqs[idx],
+				       struct scx_task_oem, node);
+		if (idx == 0)
+			list_move(&oem->node, &crq->local_dsq);
+		else
+			list_move_tail(&oem->node, &crq->local_dsq);
+		if (crq->user_nr_queued[idx] > 0)
+			crq->user_nr_queued[idx]--;
+		crq->local_nr_queued++;
+		oem->dsq_slot = 1;
+		moved = true;
+	}
+	raw_spin_unlock_irqrestore(&crq->lock, flags);
+
